# Copy to /opt/followup-runner/.env (chmod 640, owner root:followup).

# Listener (claude-ops). Only Vikunja (CT 106) may post.
LISTEN_HOST=192.168.20.20
LISTEN_PORT=8790
WEBHOOK_PATH=/vikunja
ALLOWED_SOURCES=192.168.20.6
# Same secret as entered on each Vikunja project webhook.
WEBHOOK_SECRET=

# MCP tokens for the runner's own identities: Vikunja bot bot-claude-runner, Outline user claude-runner.
TASKS_MCP_URL=https://tasks.local.kf11-home.uk/api/v2/mcp
TASKS_MCP_TOKEN=
OUTLINE_MCP_URL=https://outline.local.kf11-home.uk/mcp
OUTLINE_MCP_TOKEN=

# Claude Code auth for headless use: output of `claude setup-token` (subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# Must be outside /home (the unit sets ProtectHome=true); see README
CLAUDE_BIN=/usr/local/bin/claude
# Optional: pin a model, e.g. sonnet
CLAUDE_MODEL=

# Limits
MAX_BUDGET_USD=1.00
MAX_RUNS_PER_DAY=10
RUN_TIMEOUT_MIN=15

# Optional: Home Assistant webhook ({title, message}) forwarding to notify.tim
NOTIFY_URL=

STATE_DIR=/var/lib/followup-runner
# Set to 1 to log decisions without calling Claude (dry runs don't count
# towards the daily cap or mark the task handled)
DRY_RUN=0
